{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "poseidon",
  "snapshots": false,
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "policies": [
    {
      "action": "tool.use",
      "resource": "edit:.opencode",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:.opencode/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*/.opencode",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*/.opencode/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:opencode.json",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:opencode.jsonc",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*/opencode.json",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*/opencode.jsonc",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:~/.config/opencode/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*/.config/opencode/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:.agents/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*/.agents/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:.codex/*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "edit:*/.codex/*",
      "effect": "deny"
    }
  ],
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.next/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/.cache/**"
    ]
  }
}
